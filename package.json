{
  "name": "distillmd",
  "version": "0.1.0",
  "description": "Turn documents into token-lean Markdown using LiteParse",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "distillmd": "dist/cli.js",
    "distill": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsup",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@llamaindex/liteparse": "^2.18.0",
    "commander": "^15.0.0",
    "gpt-tokenizer": "^4.1.0",
    "hono": "^4.13.16"
  },
  "optionalDependencies": {
    "@atjsh/llmlingua-2": "^3.0.0",
    "@huggingface/transformers": "^4.3.2",
    "js-tiktoken": "^1.0.21"
  }
}
