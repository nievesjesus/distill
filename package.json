{
  "name": "distillmd",
  "version": "0.1.0",
  "description": "Turn documents into token-lean Markdown using LiteParse",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "distillmd": "dist/cli.js",
    "distill": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config web/vite.config.ts && tsup",
    "dev:web": "vite --config web/vite.config.ts",
    "check:deps": "node scripts/check-lock.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@huggingface/transformers": "^4.3.2",
    "@llamaindex/liteparse": "^2.18.0",
    "commander": "^14.0.0",
    "gpt-tokenizer": "^4.1.0",
    "hono": "^4.13.16",
    "js-tiktoken": "^1.0.21"
  },
  "optionalDependencies": {
    "@atjsh/llmlingua-2": "^3.0.0"
  }
}
