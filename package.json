{
  "name": "distillmd",
  "version": "0.1.0",
  "description": "Turn documents into token-lean Markdown using LiteParse",
  "author": "Jesus Nieves <yo@nievesjesus.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nievesjesus/distill.git"
  },
  "homepage": "https://nievesjesus.github.io/distill/",
  "bugs": {
    "url": "https://github.com/nievesjesus/distill/issues"
  },
  "keywords": [
    "pdf",
    "markdown",
    "llm",
    "tokens",
    "mcp",
    "claude-code",
    "opencode",
    "liteparse",
    "ocr",
    "rag"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "distillmd": "dist/cli.js",
    "distill": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/web",
    "lingua-runtime/package.json",
    "lingua-runtime/package-lock.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config web/vite.config.ts && tsup",
    "prepack": "npm run build",
    "dev:web": "vite --config web/vite.config.ts",
    "check:deps": "node scripts/check-lock.mjs",
    "test:smoke": "npm run build && vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "build:desktop": "npm run build && tsup --config desktop/tsup.desktop.config.ts",
    "desktop": "npm run build:desktop && electron .",
    "test:desktop": "npm run build:desktop && playwright test --config playwright.desktop.config.ts",
    "fetch:tessdata": "node scripts/fetch-tessdata.mjs",
    "dist:lite": "npm run fetch:tessdata && electron-builder --config electron-builder.lite.yml",
    "dist:full": "npm run fetch:tessdata && npm run prepare:lingua && electron-builder --config electron-builder.full.yml",
    "prepare:lingua": "node scripts/prepare-lingua.mjs",
    "check:variant": "node scripts/check-variant.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "marketing": "node scripts/marketing/make-demo-docs.mjs && node scripts/marketing/screenshots.mjs && node scripts/marketing/banner.mjs",
    "marketing:measure": "node scripts/marketing/measure-claude.mjs"
  },
  "devDependencies": {
    "@atjsh/llmlingua-2": "3.0.0",
    "@electron/asar": "^4.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "js-tiktoken": "1.0.21",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@llamaindex/liteparse": "^2.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "^15.0.0",
    "gpt-tokenizer": "^4.1.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "main": "dist/desktop/main.js",
  "exports": {
    "./package.json": "./package.json"
  }
}
