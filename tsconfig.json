{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@core/*": [
        "./src/core/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "tests",
    "web",
    "vitest.config.ts",
    "e2e",
    "playwright.config.ts",
    "desktop",
    "playwright.desktop.config.ts"
  ]
}
