{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@core/*": ["./src/core/*"] }
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
